{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macwallpaperpro-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",

  // Production hostname (Workers custom domain on the elizos.com zone). Local dev keeps using localhost:8787.
  "routes": [
    { "pattern": "macwallpaper.elizos.com", "custom_domain": true },
    // root domain → forwards to the site; serves ads.txt + AdSense verification itself
    { "pattern": "elizos.com", "custom_domain": true },
    { "pattern": "www.elizos.com", "custom_domain": true }
  ],
  "workers_dev": false,

  // Static files (fonts, CSS, JS, i18n). Every HTML page is rendered by the Worker so it can pick the
  // language, set <html lang dir> and choose the right CSP. Static files skip the Worker entirely.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*", "!/i18n/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "macwallpaperpro",
      // Placeholder for local dev. Replace with the real id after `wrangler d1 create macwallpaperpro`.
      "database_id": "daf9591b-c3dc-4c44-95b9-b4edd6aba05c",
      "migrations_dir": "./migrations"
    }
  ],

  "r2_buckets": [
    // Private bucket: never enable public access. All reads go through the Worker.
    { "binding": "BUCKET", "bucket_name": "macwallpaperpro-files" }
  ],

  "vars": {
    // "development" enables the dev-only sign-in. Override in .dev.vars for local work; never in production.
    "ENVIRONMENT": "production",
    "SITE_URL": "https://macwallpaper.elizos.com",
    // Optional extra allowed Origins for state-changing requests (comma separated).
    "ALLOWED_ORIGINS": "",
    // Google AdSense. Leave empty to show no ads at all (no ad markup, no ad CSP, no consent banner).
    "ADSENSE_CLIENT": "ca-pub-5873755708069276",
    "ADSENSE_SLOT_BROWSE": "",
    "ADSENSE_SLOT_DETAIL": "",
    "ADSENSE_SLOT_FOOTER": "",
    // OAuth client ids are public; the secrets are set with `wrangler secret put`.
    "GOOGLE_CLIENT_ID": "",
    "GITHUB_CLIENT_ID": "Ov23li3c8m9nJ6YHmljr"
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
